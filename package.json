{
  "name": "mcp-sentinel",
  "version": "2.0.0",
  "description": "Secure MCP Server for remote server control via AI cloud services",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "node setup.js",
    "keygen": "node keygen.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --experimental-test-module-mocks --test tests/unit/*.test.js",
    "test:integration": "node --experimental-test-module-mocks --test tests/integration/*.test.js",
    "test:server-contracts": "node --experimental-test-module-mocks --test tests/server-contracts/*.test.js",
    "test:mcp-contracts": "node --experimental-test-module-mocks --test tests/mcp-contracts/*.test.js",
    "test:scripts": "node --experimental-test-module-mocks --test tests/scripts/*.test.js",
    "test:privileged": "node --experimental-test-module-mocks --test tests/privileged/*.test.js",
    "test:browser": "npx playwright test",
    "test:coverage:node": "rm -rf coverage .nyc_output && c8 --clean=false npm run test:unit && c8 --clean=false npm run test:integration && c8 --clean=false npm run test:server-contracts && c8 --clean=false npm run test:mcp-contracts && c8 --clean=false npm run test:scripts",
    "test:coverage:node:report": "c8 report --reporter=json --report-dir coverage/node --temp-directory coverage/tmp",
    "test:coverage:browser": "npm run test:browser",
    "test:coverage:merge": "node scripts/merge-coverage.js",
    "test:coverage:verify": "node scripts/verify-coverage.js",
    "test:mutation": "npx stryker run",
    "test:user-needs": "node scripts/validate-user-needs.mjs",
    "test:integrity": "node scripts/detect-unsafe-tests.mjs",
    "test:all": "npm run test:unit && npm run test:browser",
    "test": "npm run test:all",
    "audit:verify": "node scripts/verify-audit.js",
    "migrate:dry-run": "node scripts/migrate-state.js --dry-run",
    "migrate:apply": "node scripts/migrate-state.js --apply",
    "deploy:preflight": "node scripts/production-preflight.js",
    "deploy": "./install.sh",
    "legacy:export": "node scripts/export-legacy-state.js",
    "release:bundle": "./scripts/build-release.sh",
    "update:authelia": "./scripts/update-authelia.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.4",
    "@simplewebauthn/server": "^13.3.2",
    "acme-client": "^5.4.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ipaddr.js": "^2.4.0",
    "jose": "^6.2.4",
    "js-yaml": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.23.1",
    "pg": "^8.22.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/compression": "^1.8.1",
    "c8": "^12.0.0",
    "coverage-v8": "^0.0.1-security",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "prettier": "^3.9.6",
    "v8-to-istanbul": "^9.3.0"
  }
}
