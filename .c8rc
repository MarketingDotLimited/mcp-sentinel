{
  "all": true,
  "check-coverage": true,
  "per-file": false,
  "include": [
    "lib/**",
    "routes/**",
    "tools/**",
    "server.js",
    "broker.js",
    "node-gateway.js",
    "audit.js",
    "keystore.js",
    "security.js"
  ],
  "exclude": ["tests/**", "scratch/**", "node_modules/**", "coverage/**", "eslint.config.js"],
  "reporter": ["text", "html", "lcov", "json", "json-summary"],
  "statements": 100,
  "branches": 100,
  "functions": 100,
  "lines": 100
}
