{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm run test:unit"
  },
  "mutate": ["server.js", "broker.js", "lib/**/*.js", "tools/**/*.js", "routes/**/*.js"],
  "thresholds": {
    "high": 100,
    "low": 99,
    "break": 100
  },
  "reporters": ["html", "clear-text", "progress"],
  "ignorePatterns": ["coverage/**", "tests/**", "scripts/**"],
  "concurrency": 2
}
